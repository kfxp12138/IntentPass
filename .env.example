# Local preview works without credentials. All values below are server-side.
# Copy to .env only for your own instance. Never commit the populated file.
PORT=3000
SETTLEMENT_ASSET_MODE=demo-erc20

# Optional model integrations: use your own accounts.
TYPESAFE_API_KEY=
JEV_MODEL=
REVIEW_POLICY_PATH=
REVIEW_JOURNAL_DB_PATH=
# Full HTTPS Chat Completions endpoint, including /chat/completions.
PLANNER_API_URL=
PLANNER_API_KEY=
PLANNER_MODEL=

# Authentication and existing delegated wallets.
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_POLICY_ID=
PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_EXECUTOR_ADDRESS=
PRIVY_GAS_LIMIT=2000000
PRIVY_REVIEWER_WALLET_ID=
PRIVY_REVIEWER_POLICY_ID=
PRIVY_REVIEWER_SIGNER_ID=
PRIVY_REVIEWER_AUTHORIZATION_PRIVATE_KEY=

# Supply a complete, verified deployment together; examples are not live authority.
MONAD_RPC_URL=
CHAIN_ID=
ASSET_ADDRESS=
ARBITER_ADDRESS=
REVIEWER_ADDRESS=
COMMITTEE_ADDRESSES=
ELIGIBILITY_GATE_ADDRESS=
QUOTE_CATALOG_PATH=
PURCHASE_BOND=
DELIVERY_SECONDS=1800
SETTLEMENT_SECONDS=3600

# Explicit private absolute paths with an existing parent directory.
AUTOMATION_DATA_DIRECTORY=
REVIEW_RECEIPT_DB_PATH=
APPROVAL_DB_PATH=
FUNDING_DB_PATH=
DELIVERY_DB_PATH=
ACCEPTANCE_DB_PATH=
VOTE_DB_PATH=
WITHDRAWAL_DB_PATH=
ALLOCATION_DB_PATH=

# Local authenticated bridges stay disabled by default.
INTENTPASS_LOCAL_SDK_READ_ENABLED=0
INTENTPASS_LOCAL_SDK_PROCUREMENT_ENABLED=0
PUBLIC_HTTPS_URL=
